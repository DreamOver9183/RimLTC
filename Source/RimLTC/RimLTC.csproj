<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- Target game version. Build for 1.7 with: dotnet build -p:RimWorldVersion=1.7 -->
    <RimWorldVersion Condition="'$(RimWorldVersion)' == ''">1.6</RimWorldVersion>
    <TargetFramework>net472</TargetFramework>
    <LangVersion>latest</LangVersion>
    <RootNamespace>RimLTC</RootNamespace>
    <AssemblyName>RimLTC</AssemblyName>
    <Version>0.1.0</Version>
    <Nullable>disable</Nullable>
    <DebugType>none</DebugType>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <AppendRuntimeIdentifierToOutputPath>false</AppendRuntimeIdentifierToOutputPath>
    <OutputPath>..\..\$(RimWorldVersion)\Assemblies\</OutputPath>
    <EnableDefaultCompileItems>true</EnableDefaultCompileItems>
  </PropertyGroup>

  <PropertyGroup Condition="'$(RimWorldVersion)' == '1.6'">
    <RimWorldRefVersion>1.6.4871</RimWorldRefVersion>
    <DefineConstants>$(DefineConstants);RW16</DefineConstants>
  </PropertyGroup>

  <PropertyGroup Condition="'$(RimWorldVersion)' == '1.7'">
    <RimWorldRefVersion>1.7.*-*</RimWorldRefVersion>
    <DefineConstants>$(DefineConstants);RW17</DefineConstants>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Krafs.Rimworld.Ref" Version="$(RimWorldRefVersion)" ExcludeAssets="runtime" PrivateAssets="all" />
    <PackageReference Include="Lib.Harmony.Ref" Version="2.3.6" ExcludeAssets="runtime" PrivateAssets="all" />
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
  </ItemGroup>

</Project>
